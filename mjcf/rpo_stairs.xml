<mujoco model="rpo">
<compiler angle="radian" meshdir="../meshes/" eulerseq="zyx"/>
<option timestep="0.001" iterations="100" solver="PGS" gravity="0 0 -9.81">
<flag frictionloss="enable"/>
</option>
<size njmax="5000" nconmax="1000"/>
<visual>
<quality shadowsize="4096"/>
<map znear="0.001" zfar="50"/>
</visual>
<default>
<joint limited="true"/>
<motor ctrllimited="true"/>
<geom condim="4" contype="1" conaffinity="0" solref="0.001 2" friction="0.9 0.2 0.2" group="1"/>
<equality solref="0.001 2"/>
<default class="visualgeom">
<geom material="visualgeom" condim="1" contype="0" conaffinity="0"/>
</default>
<default class="obstacle">
<geom material="obstacle" condim="3" contype="1" conaffinity="15"/>
</default>
<default class="waist_joint_param">
<joint damping="0.01" frictionloss="0.01" armature="0.01"/>
</default>
<default class="leg_joint_param">
<joint damping="0.01" frictionloss="0.01" armature="0.01"/>
</default>
<default class="arm_joint_param">
<joint damping="0.01" frictionloss="0.01" armature="0.01"/>
</default>
<!-- Environment: stair box geoms use same solref as robot collision (was 0.02 → soft / visible sink vs plane). -->
<default class="stair_tread">
<geom type="box" condim="4" contype="1" conaffinity="15" friction="1 0.005 0.0001"
      solref="0.001 2" margin="0" gap="0" priority="1"
      material="mat_stair_tread" group="0"/>
</default>
<default class="stair_riser">
<geom type="box" condim="4" contype="1" conaffinity="15" friction="1 0.005 0.0001"
      solref="0.001 2" margin="0" gap="0" priority="1"
      material="mat_stair_riser" group="0"/>
</default>
</default>
